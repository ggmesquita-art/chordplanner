{
  "name": "chordplanner",
  "private": true,
  "version": "0.2.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "app": "vite build && electron .",
    "app:samples": "vite build && electron . --mirror-samples",
    "app:dist": "vite build && electron-builder --mac --publish never",
    "app:dist:win": "vite build && electron-builder --win --publish never",
    "ai:server": "python -m music_ai_module.server"
  },
  "dependencies": {
    "@tonejs/midi": "^2.0.28",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "smplr": "^1.0.0",
    "tone": "^15.1.22",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "45.3.4",
    "electron-builder": "26.18.0",
    "jsdom": "^30.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "main": "electron/main.js",
  "build": {
    "appId": "app.chordplanner.desktop",
    "productName": "ChordPlanner",
    "directories": {
      "output": "release",
      "buildResources": "electron/resources"
    },
    "files": [
      "dist/**/*",
      "electron/main.js",
      "electron/preload.cjs",
      "package.json",
      "!node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "desktop-samples",
        "to": "samples",
        "filter": [
          "**/*",
          "!**/*.tmp"
        ]
      },
      {
        "from": "music_ai_module",
        "to": "ai-server/music_ai_module",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/*.pyc",
          "!**/.pytest_cache/**",
          "!tests/**",
          "!.venv*/**",
          "!models/**"
        ]
      },
      {
        "from": ".agents/skills/music-composition",
        "to": "ai-server/music-composition",
        "filter": [
          "**/*",
          "!benchmarks/**",
          "!.git/**"
        ]
      },
      {
        "from": "dist-ai",
        "to": "ai-server",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.music",
      "icon": "electron/resources/icon.png",
      "identity": null
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "electron/resources/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    }
  },
  "description": "Planejador de progressões de acordes com roda harmônica, arranjo e exportação para DAW e partitura."
}
